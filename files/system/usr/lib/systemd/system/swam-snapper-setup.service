[Unit]
Description=Crée la config snapper « home » sur /var/home (swam-os)
# La config snapper ne peut être créée qu'au RUNTIME : /var/home (btrfs)
# n'existe pas dans le buildroot. Idempotent : no-op si /var/home/.snapshots
# existe déjà (config créée ou volontairement supprimée → on ne la recrée pas).
ConditionPathExists=/sys/fs/btrfs
ConditionPathExists=!/var/home/.snapshots
After=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/snapper -c home create-config /var/home
# Timeline horaire, purge progressive ; yearly désactivé (drive de jeu).
ExecStart=/usr/bin/snapper -c home set-config TIMELINE_CREATE=yes,TIMELINE_LIMIT_HOURLY=10,TIMELINE_LIMIT_DAILY=7,TIMELINE_LIMIT_WEEKLY=4,TIMELINE_LIMIT_MONTHLY=2,TIMELINE_LIMIT_YEARLY=0

[Install]
WantedBy=multi-user.target
